// ============================================================
// SAAP — Sistema de Agendamento de Atendimentos Profissionais
// Diagrama de Classes Conceituais (DBML para dbdiagram.io)
// ============================================================

// ─────────────────────────────────────────
// ENUMERAÇÕES DE DOMÍNIO
// ─────────────────────────────────────────

Enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  REALIZADO
  CANCELADO
}

Enum PapelProfissional {
  MEDICO
  ENFERMEIRO
  ASSISTENTE
  ADMINISTRADOR
  RECEPCIONISTA
}

Enum TipoNotificacao {
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

Enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

// ─────────────────────────────────────────
// AUTENTICAÇÃO / ACESSO
// ─────────────────────────────────────────

Table Usuario {
  id UUID [pk, note: 'Identificador único']
  email VARCHAR [unique, not null, note: 'E-mail de login']
  senha_hash VARCHAR [not null, note: 'Hash BCrypt da senha']
  ativo BOOLEAN [default: true, note: 'Conta ativa/inativa']
  paciente_id UUID [unique, note: 'Vínculo opcional com Paciente']
  profissional_id UUID [unique, note: 'Vínculo opcional com Profissional']
  criado_em TIMESTAMP [default: `now()`, not null]
  atualizado_em TIMESTAMP [not null]

  Note: 'Credencial de acesso ao sistema. Separa autenticação das regras de negócio (RBAC).'
}

// ─────────────────────────────────────────
// ENTIDADES CORE DO DOMÍNIO
// ─────────────────────────────────────────

Table Paciente {
  id UUID [pk]
  nome VARCHAR [not null]
  cpf VARCHAR [unique, not null, note: 'Documento de identificação']
  contato VARCHAR [not null, note: 'Telefone ou e-mail de contato']
  data_nascimento DATE
  criado_em TIMESTAMP [default: `now()`, not null]
  atualizado_em TIMESTAMP [not null]

  Note: 'Pessoa que solicita atendimentos, acompanha agendamentos e confirma presença.'
}

Table Profissional {
  id UUID [pk]
  nome VARCHAR [not null]
  registro_profissional VARCHAR [unique, note: 'CRM, COREN, etc. Opcional para assistentes']
  especialidade VARCHAR [note: 'Ex: Cardiologia, Fisioterapia']
  papel PapelProfissional [not null, default: 'MEDICO']
  criado_em TIMESTAMP [default: `now()`, not null]
  atualizado_em TIMESTAMP [not null]

  Note: 'Ator que executa atendimentos e registra evoluções clínicas.'
}

Table Servico {
  id UUID [pk]
  descricao VARCHAR [not null, note: 'Ex: Consulta, Exame, Retorno']
  duracao_minutos INT [not null]
  preco DECIMAL [not null, note: 'Valor base do serviço']
  criado_em TIMESTAMP [default: `now()`, not null]
  atualizado_em TIMESTAMP [not null]

  Note: 'Define o que é oferecido pela clínica, incluindo duração e valor.'
}

// ─────────────────────────────────────────
// CLASSE CENTRAL — AGENDAMENTO
// ─────────────────────────────────────────

Table Agendamento {
  id UUID [pk]
  data_hora TIMESTAMP [not null, note: 'Data e horário do atendimento']
  status StatusAgendamento [not null, default: 'PENDENTE']
  paciente_id UUID [not null]
  profissional_id UUID [not null]
  servico_id UUID [not null]
  convenio_id UUID [note: 'Convênio utilizado (opcional)']
  criado_em TIMESTAMP [default: `now()`, not null]
  atualizado_em TIMESTAMP [not null]

  Note: 'Classe central que relaciona Paciente, Profissional e Serviço. Encapsula toda a lógica de transição de estados.'
}

// ─────────────────────────────────────────
// GRADE DE HORÁRIOS
// ─────────────────────────────────────────

Table GradeHorario {
  id UUID [pk]
  profissional_id UUID [not null]
  dia_semana DiaSemana [not null]
  hora_inicio TIME [not null]
  hora_fim TIME [not null]
  disponivel BOOLEAN [default: true]

  Note: 'Intervalos de disponibilidade semanal de cada profissional.'
}

// ─────────────────────────────────────────
// PRONTUÁRIO / HISTÓRICO CLÍNICO
// ─────────────────────────────────────────

Table Prontuario {
  id UUID [pk]
  paciente_id UUID [not null]
  agendamento_id UUID [not null, note: 'Atendimento que gerou o registro']
  data_registro TIMESTAMP [default: `now()`, not null]
  observacoes TEXT [note: 'Notas clínicas do profissional']
  diagnostico TEXT
  prescricao TEXT
  criado_em TIMESTAMP [default: `now()`, not null]

  Note: 'Registro cronológico de interações e observações clínicas por atendimento.'
}

// ─────────────────────────────────────────
// CONVÊNIOS E PLANOS
// ─────────────────────────────────────────

Table Convenio {
  id UUID [pk]
  nome VARCHAR [not null, note: 'Ex: Unimed, SulAmérica']
  codigo_plano VARCHAR [unique, not null]
  ativo BOOLEAN [default: true]
  criado_em TIMESTAMP [default: `now()`, not null]
  atualizado_em TIMESTAMP [not null]

  Note: 'Regras de aceitação e tabelas de preços para diferentes planos.'
}

Table ConvenioServico {
  id UUID [pk]
  convenio_id UUID [not null]
  servico_id UUID [not null]
  preco_convenio DECIMAL [not null, note: 'Valor coberto pelo convênio para este serviço']

  Note: 'Tabela associativa N:N entre Convênio e Serviço com preço diferenciado.'
}

// ─────────────────────────────────────────
// RELAÇÃO N:N — PROFISSIONAL ↔ SERVIÇO
// ─────────────────────────────────────────

Table ProfissionalServico {
  id UUID [pk]
  profissional_id UUID [not null]
  servico_id UUID [not null]

  Note: 'Tabela associativa N:N. Um profissional pode oferecer múltiplos serviços e vice-versa.'
}

// ─────────────────────────────────────────
// RELAÇÃO N:N — PACIENTE ↔ CONVÊNIO
// ─────────────────────────────────────────

Table PacienteConvenio {
  id UUID [pk]
  paciente_id UUID [not null]
  convenio_id UUID [not null]
  numero_carteirinha VARCHAR [note: 'Identificador do paciente no convênio']
  data_validade DATE

  Note: 'Tabela associativa N:N. Um paciente pode ter múltiplos convênios.'
}

// ─────────────────────────────────────────
// NOTIFICAÇÕES E LEMBRETES
// ─────────────────────────────────────────

Table Notificacao {
  id UUID [pk]
  agendamento_id UUID [not null]
  tipo TipoNotificacao [not null]
  mensagem TEXT [not null]
  enviado_em TIMESTAMP
  lida BOOLEAN [default: false]
  criado_em TIMESTAMP [default: `now()`, not null]

  Note: 'Lembretes e confirmações enviados via E-mail, WhatsApp, SMS ou Push.'
}

// ─────────────────────────────────────────
// FILA DE ESPERA INTELIGENTE
// ─────────────────────────────────────────

Table FilaEspera {
  id UUID [pk]
  paciente_id UUID [not null]
  servico_id UUID [not null]
  profissional_id UUID [note: 'Preferência de profissional (opcional)']
  data_entrada TIMESTAMP [default: `now()`, not null]
  prioridade INT [default: 0, note: 'Maior valor = maior prioridade']
  notificado BOOLEAN [default: false]

  Note: 'Notifica pacientes quando surge vaga em horário concorrido.'
}

// ============================================================
// RELACIONAMENTOS (References)
// ============================================================

// Usuario ↔ Perfis de domínio
Ref: Usuario.paciente_id - Paciente.id
Ref: Usuario.profissional_id - Profissional.id

// Agendamento → Entidades core
Ref: Agendamento.paciente_id > Paciente.id
Ref: Agendamento.profissional_id > Profissional.id
Ref: Agendamento.servico_id > Servico.id
Ref: Agendamento.convenio_id > Convenio.id

// Grade de horários
Ref: GradeHorario.profissional_id > Profissional.id

// Prontuário
Ref: Prontuario.paciente_id > Paciente.id
Ref: Prontuario.agendamento_id > Agendamento.id

// Tabelas associativas N:N
Ref: ProfissionalServico.profissional_id > Profissional.id
Ref: ProfissionalServico.servico_id > Servico.id
Ref: ConvenioServico.convenio_id > Convenio.id
Ref: ConvenioServico.servico_id > Servico.id
Ref: PacienteConvenio.paciente_id > Paciente.id
Ref: PacienteConvenio.convenio_id > Convenio.id

// Notificações
Ref: Notificacao.agendamento_id > Agendamento.id

// Fila de espera
Ref: FilaEspera.paciente_id > Paciente.id
Ref: FilaEspera.servico_id > Servico.id
Ref: FilaEspera.profissional_id > Profissional.id
